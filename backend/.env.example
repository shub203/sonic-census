# Application
PROJECT_NAME=Sonic Census
API_V1_STR=/api/v1
SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite (default zero-friction): sqlite:///./noisepollution.db
# For PostgreSQL with PostGIS: postgresql+psycopg://username:password@localhost:5432/noisepollution
DATABASE_URL=sqlite:///./noisepollution.db

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# AI & Processing
MODEL_PATH=models/Cnn14.pth
DEVICE=cpu
UPLOAD_DIRECTORY=uploads
REPORTS_DIRECTORY=generated_reports
SPECTROGRAMS_DIRECTORY=generated_spectrograms
MAX_UPLOAD_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=60

# Optional Third-Party Services
OPENAI_API_KEY=
RESEND_API_KEY=
GOOGLE_MAPS_API_KEY=
